{
    "name": "scala-sbt-codespaces-template",
    "image": "sbtscala/scala-sbt:graalvm-community-21.0.2_1.12.8_3.8.2",
    "customizations": {
        "vscode": {
            "extensions": [
                // Scala
                "scala-lang.scala@0.5.7",
                "scalameta.metals@1.26.1",
                // Git
                "Exelord.git-commits"
                // Various
                // "GitHub.copilot" // Uncomment to use GitHub Copilot
            ]
        }
    },
    "postCreateCommand": "bash .devcontainer/post-create.sh",
    "remoteUser": "sbtuser"
}